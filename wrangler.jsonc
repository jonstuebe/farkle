{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farkle",
  "compatibility_date": "2026-11-19",
  // Static-only for now: Cloudflare serves the Vite build output directly.
  // Add a "main" Worker script here later for an API / Durable Objects.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
